{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PurePy manifest schema 1 (decoded TOML)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": { "const": 1 },
    "module": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "type": { "type": "array", "items": { "$ref": "#/$defs/type" } },
    "function": { "type": "array", "items": { "$ref": "#/$defs/function" } }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1 },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "import_safe"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "import_safe": { "type": "boolean" }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "category": { "enum": ["value", "capability", "host_ref"] },
        "immutable": { "const": true },
        "labels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^[^\\s\\u0000-\\u001f\\u007f*?]+$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "category": { "const": "value" } } },
          "then": { "required": ["immutable"] },
          "else": { "not": { "required": ["immutable"] } }
        },
        {
          "if": { "properties": { "category": { "const": "capability" } } },
          "then": { "required": ["labels"] },
          "else": { "not": { "required": ["labels"] } }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "trust", "parameters", "returns"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["sync", "async"] },
        "trust": { "enum": ["pure", "host"] },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "returns": { "type": "string", "minLength": 1 }
      }
    }
  }
}
